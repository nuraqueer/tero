{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tero",
  "version": "0.1.0",
  "identifier": "tero.pherus.org",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [{ "title": "Tero", "width": 1024, "height": 768 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
