{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "testflight": {
      "distribution": "store",
      "developmentClient": false,
      "autoIncrement": true,
      "channel": "testflight",
      "environment": "preview",
      "env": {
        "SEFIRAH_NATIVE_BUILD": "1",
        "TERO_NATIVE_TESTING": "1",
        "EXPO_PUBLIC_SEFIRAH_EXPERIMENTAL": "enabled",
        "EXPO_PUBLIC_API_URL": "http://192.168.1.4:8794"
      },
      "ios": { "simulator": false }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "testflight": {
      "ios": { "ascAppId": "6822219523" }
    },
    "production": {}
  }
}
