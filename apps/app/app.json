{
  "expo": {
    "name": "Tero",
    "slug": "tero",
    "scheme": "tero",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF9F5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tero.pherus.org",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "tero.pherus.org",
      "adaptiveIcon": {
        "backgroundColor": "#141413",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "messages",
          "color": "#A75B4A",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Tero uses the camera only to scan Tero cards.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Tero saves your Tero card image to Photos only when you ask.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tero uses Face ID to open the app, only if you turn it on."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Tero uses Face ID to open the app, only if you turn it on."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "pherus",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56e478f4-7f95-45e3-9fae-e8321fcea451"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/56e478f4-7f95-45e3-9fae-e8321fcea451"
    }
  }
}
