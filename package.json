{
  "name": "tero",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "vite dev --port 3000",
    "build:web": "vite build",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "turbo:check": "turbo run typecheck test",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "format": "prettier --write apps packages",
    "format:check": "prettier --check apps packages",
    "check": "bun run format:check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@passui/react": "^0.1.23",
    "@passui/tanstack": "^0.2.6",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.169.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
