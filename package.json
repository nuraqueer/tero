{
  "name": "tero-workspace",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "bun run --cwd apps/tero dev",
    "build:web": "bun run --cwd apps/tero build",
    "typecheck:web": "bun run --cwd apps/tero typecheck",
    "dev:tauri": "bun run --cwd apps/tero dev:tauri",
    "build:tauri": "bun run --cwd apps/tero build:tauri",
    "turbo:check": "turbo run typecheck test",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "format": "prettier --write apps packages",
    "format:check": "prettier --check apps packages",
    "check": "bun run format:check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/bun": "^1.4.3",
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
