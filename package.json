{
  "name": "tero",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "format": "prettier --write apps packages",
    "format:check": "prettier --check apps packages",
    "check": "bun run format:check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
